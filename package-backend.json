{
  "name": "krishiverse-backend",
  "version": "2.0.0",
  "description": "Optional backend for KrishiVerse PWA - user sync, analytics, premium features",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha tests/**/*.test.js --timeout 10000",
    "test:unit": "mocha tests/unit/**/*.test.js",
    "test:integration": "mocha tests/integration/**/*.test.js",
    "test:e2e": "mocha tests/e2e/**/*.test.js",
    "lint": "eslint src --fix",
    "build": "echo 'No build step required for Node.js'",
    "db:seed": "node scripts/seed-data.js",
    "db:migrate": "node scripts/db-migrate.js",
    "docker:build": "docker build -t krishiverse-api .",
    "docker:run": "docker run -p 3001:3001 --env-file .env krishiverse-api"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "cloudinary": "^1.41.0",
    "multer": "^1.4.5-lts.1",
    "twilio": "^4.9.1",
    "redis": "^4.6.12",
    "node-cache": "^5.1.2",
    "@sentry/node": "^7.84.0",
    "winston": "^3.11.0",
    "express-async-errors": "^3.1.1",
    "axios": "^1.6.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "uuid": "^9.0.1",
    "compression": "^1.7.4",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.6",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "jest-mongodb": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "agriculture",
    "farming",
    "api",
    "backend",
    "express",
    "mongodb",
    "rest-api",
    "pwa",
    "farmers"
  ],
  "author": "CodeNest Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codenest/krishiverse-backend.git"
  },
  "bugs": {
    "url": "https://github.com/codenest/krishiverse-backend/issues"
  },
  "homepage": "https://github.com/codenest/krishiverse-backend#readme"
}
