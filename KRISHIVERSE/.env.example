# Frontend example .env — copy this to .env and fill in your keys
# Online AI goes through the backend proxy — do NOT put any AI API key here.
VITE_GROQ_MODEL=llama-3.1-8b-instant
VITE_API_BASE=http://localhost:3001/api/v1

# Weather API key (used only as a direct fallback; backend proxy is preferred)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Gemini API key (disease verification / premium chat) — optional
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# App defaults
VITE_DEFAULT_LANGUAGE=en
VITE_SITE_NAME=KrishiVerse

# Laya structured decisions (Phase 1: backend-only, optional). Default OFF until
# tests + benchmark + safety verification pass. Never put secrets in VITE_ vars.
VITE_ENABLE_LAYA_DECISIONS=false
