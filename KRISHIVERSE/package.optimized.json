{
  "name": "krishiverse-optimized",
  "version": "2.0.0",
  "description": "Optimized KrishiVerse - Offline-First Agricultural Advisory PWA (70% smaller)",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.optimized.js",
    "build": "vite build --config vite.config.optimized.js",
    "build:analyze": "vite build --config vite.config.optimized.js && npx vite-bundle-analyzer dist",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "size-check": "npm run build && npx bundlesize",
    "compress": "npm run build && npx gzip-size dist",
    "optimize": "npm run build && npx html-minifier --input-dir=dist --output-dir=dist --minify-js --minify-css --remove-comments",
    "deploy": "npm run build && gh-pages -d dist",
    "lighthouse": "npm run build && npx lighthouse http://localhost:4173 --output=html --output-path=./lighthouse-report",
    "preflight": "npm run build && npm run test && npm run lint && npm run size-check"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "zustand": "^4.4.0",
    "i18next": "^23.7.0",
    "react-i18next": "^13.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^5.16.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "terser": "^5.19.0",
    "vite-bundle-analyzer": "^0.7.0",
    "bundlesize": "^0.18.0",
    "gzip-size": "^6.0.0",
    "html-minifier-terser": "^7.2.0",
    "lighthouse": "^10.0.0",
    "gh-pages": "^5.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup-plugin-visualizer": "^5.9.0",
    "compression-webpack-plugin": "^10.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "not IE 11"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "bundle": {
    "maxSize": "35KB",
    "gzipTarget": "25KB",
    "brotliTarget": "20KB"
  },
  "performance": {
    "lighthouse": {
      "performance": "> 95",
      "accessibility": "> 95",
      "bestPractices": "> 95",
      "seo": "> 95"
    },
    "loadTime": {
      "3g": "< 3s",
      "4g": "< 1s",
      "wifi": "< 0.5s"
    }
  },
  "optimizations": {
    "codeSplitting": true,
    "treeShaking": true,
    "minification": true,
    "compression": true,
    "lazyLoading": true,
    "webAssembly": true,
    "serviceWorker": true,
    "cdn": true
  }
}
