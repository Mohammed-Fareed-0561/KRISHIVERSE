{
  "name": "krishiverse",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "description": "Offline-first agricultural advisory PWA for farmers in South India",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:kb": "node scripts/migrate-kb.mjs",
    "deploy": "gh-pages -d dist",
    "kb:ingest": "node scripts/kb-ingest.mjs",
    "eval:joint-rag": "node scripts/joint-rag-benchmark.mjs",
    "eval:mobile-ai": "vitest run eval/mobile-ai && node eval/mobile-ai/buildRequiredResults.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.41.1",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.0",
    "chart.js": "^4.4.0",
    "daisyui": "^4.6.0",
    "framer-motion": "^12.38.0",
    "i18next": "^23.7.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "idb": "^8.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "onnxruntime-web": "^1.27.0",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.4.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.13.2",
    "react-simple-pull-to-refresh": "^1.3.4",
    "react-swipeable": "^7.0.2",
    "recharts": "^2.10.3",
    "tailwindcss": "^3.3.0",
    "uuid": "^13.0.0",
    "vite": "^5.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fake-indexeddb": "^5.0.2",
    "gh-pages": "^6.1.1",
    "globals": "^15.0.0",
    "jsdom": "^23.0.1",
    "prettier": "^3.1.1",
    "puppeteer-core": "^25.8.0",
    "selfsigned": "^5.5.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.1.0"
  }
}
