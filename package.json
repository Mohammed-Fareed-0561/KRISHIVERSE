{
  "name": "krishiverse",
  "version": "2.0.0",
  "description": "Offline-first agricultural advisory PWA for farmers in South India",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write src/**/*.{js,jsx,css}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lighthouse": "lighthouse http://localhost:5173 --view",
    "deploy": "gh-pages -d dist",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed": "node scripts/db-seed.js",
    "bundle-analyze": "vite-plugin-visualizer"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "daisyui": "^4.6.0",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "@tensorflow/tfjs": "^4.10.0",
    "@tensorflow/tfjs-converter": "^4.10.0",
    "@tensorflow/tfjs-backend-webgl": "^4.10.0",
    "@tensorflow/tfjs-backend-wasm": "^4.10.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "i18next": "^23.7.0",
    "react-i18next": "^13.4.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.4.2",
    "axios": "^1.6.0",
    "tabler-icons-react": "^1.56.0",
    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0",
    "recharts": "^2.10.3",
    "web-vitals": "^3.5.1",
    "pwa-asset-generator": "^6.2.4",
    "workbox-cli": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "jsdom": "^23.0.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.1",
    "gh-pages": "^6.1.1",
    "lighthouse": "^11.4.0",
    "vite-plugin-visualizer": "^9.3.0",
    "vite-plugin-pwa": "^0.17.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "keywords": [
    "agriculture",
    "farming",
    "pwa",
    "offline-first",
    "tamil-nadu",
    "react",
    "tensorflow",
    "crop-advisory",
    "pest-detection",
    "weather-forecast"
  ],
  "author": "CodeNest Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codenest/krishiverse.git"
  },
  "bugs": {
    "url": "https://github.com/codenest/krishiverse/issues"
  },
  "homepage": "https://codenest.github.io/krishiverse"
}
