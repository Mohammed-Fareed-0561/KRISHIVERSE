# KrishiVerse Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real keys!

# ============================================
# API KEYS (Free Tier Services)
# ============================================

# OpenWeatherMap API (free tier: 1000 calls/day)
# Get key from: https://openweathermap.org/api
VITE_OPENWEATHERMAP_KEY=your_openweather_api_key_here

# Google Places API (free tier: 28,500 requests/month)
# Get key from: https://cloud.google.com/docs/maps-platform
VITE_GOOGLE_PLACES_KEY=your_google_places_api_key_here

# Claude API (optional, for premium disease verification)
# Get key from: https://console.anthropic.com
# Leave empty if using local Ollama only (free offline)
VITE_CLAUDE_API_KEY=

# ============================================
# LOCAL AI MODELS (Offline)
# ============================================

# Ollama local LLM server address
# Install Ollama from https://ollama.ai
# Run with: ollama serve (default: http://localhost:11434)
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (Mistral 7B is recommended for farmers)
# Download with: ollama pull mistral
VITE_OLLAMA_MODEL=mistral

# TensorFlow.js Disease Detection Model URL
# Using PlantVillage ONNX model hosted on CDN
VITE_DISEASE_MODEL_URL=https://cdn.jsdelivr.net/gh/edjeelectric/plantvillage_tfjs@latest/model.json

# ============================================
# APPLICATION CONFIG
# ============================================

# Default language (Tamil, English, Telugu, Kannada, Hindi)
VITE_DEFAULT_LANGUAGE=English

# Default location (for testing)
# Format: latitude,longitude (South India Tamil Nadu default)
VITE_DEFAULT_LAT=11.0168
VITE_DEFAULT_LON=76.9558

# App version
VITE_APP_VERSION=2.0.0

# Environment (development, production)
VITE_ENV=development

# ============================================
# DATABASE CONFIG
# ============================================

# IndexedDB database name
VITE_DB_NAME=KrishiVerse

# IndexedDB version
VITE_DB_VERSION=1

# IndexedDB auto-cleanup (delete data older than X days)
VITE_DB_CLEANUP_DAYS=7

# ============================================
# ANALYTICS & MONITORING (Optional)
# ============================================

# Google Analytics (optional)
# Get tracking ID from: https://analytics.google.com
VITE_GOOGLE_ANALYTICS_ID=

# Sentry error tracking (optional)
# Get DSN from: https://sentry.io
VITE_SENTRY_DSN=

# ============================================
# CACHING CONFIG
# ============================================

# Service Worker cache version
VITE_CACHE_VERSION=krishiverse-v1

# Weather cache duration (hours)
VITE_WEATHER_CACHE_HOURS=24

# Mandi prices cache duration (hours)
VITE_MANDI_CACHE_HOURS=24

# Shop data cache duration (days)
VITE_SHOP_CACHE_DAYS=7

# ============================================
# FEATURE FLAGS (Enable/Disable Features)
# ============================================

# Enable Claude API for disease verification (if API key provided)
VITE_ENABLE_CLAUDE_VERIFICATION=false

# Enable voice input (Web Speech API)
VITE_ENABLE_VOICE_INPUT=true

# Enable background sync for offline queue
VITE_ENABLE_BACKGROUND_SYNC=true

# Enable geolocation (GPS)
VITE_ENABLE_GEOLOCATION=true

# Enable notifications
VITE_ENABLE_NOTIFICATIONS=true

# ============================================
# AGMARK MANDI PRICES API
# ============================================

# AGMARK API endpoint (Government of India)
# Documentation: https://agmarknet.gov.in/
VITE_AGMARK_API_URL=https://agmarknet.gov.in/SearchCmmMkt.aspx

# Alternative: Tamil Nadu Mandi Board (SPOT)
# Documentation: https://spot.gov.in
VITE_SPOT_API_URL=https://spot.gov.in/live-price

# Use AGMARK (true) or SPOT (false)
VITE_USE_AGMARK=true

# ============================================
# GOVERNMENT SCHEMES DATA
# ============================================

# Path to local schemes JSON (relative to public/)
VITE_SCHEMES_DATA_URL=/data/schemes.json

# Update frequency for schemes data (days)
VITE_SCHEMES_UPDATE_DAYS=30

# ============================================
# DEPLOYMENT & HOSTING
# ============================================

# GitHub Pages URL (if deploying to GitHub Pages)
VITE_GITHUB_PAGES_URL=https://codenest.github.io/krishiverse

# Netlify/Vercel deployment URL (if using those)
VITE_DEPLOYMENT_URL=https://krishiverse.netlify.app

# ============================================
# SECURITY & PRIVACY
# ============================================

# CORS proxy (if needed for cross-origin APIs)
# Example: https://cors-anywhere.herokuapp.com/
VITE_CORS_PROXY=

# Enable strict content security policy
VITE_ENABLE_CSP=true

# Store analytics data (with user consent)
VITE_ENABLE_ANALYTICS=false

# ============================================
# LOGGING & DEBUG
# ============================================

# Log level: debug, info, warn, error
VITE_LOG_LEVEL=warn

# Enable console logging in production
VITE_DEBUG_MODE=false

# ============================================
# NOTES
# ============================================

# 1. Copy this file to .env and fill in your values
#    cp .env.example .env

# 2. Get API Keys (all free tiers):
#    - OpenWeatherMap: https://openweathermap.org/api (1000 calls/day free)
#    - Google Places: https://cloud.google.com/maps-platform (28,500/month free)
#    - Claude API (optional): https://console.anthropic.com (~$0.000025 per image)

# 3. For offline-only (recommended for farmers):
#    - Leave VITE_CLAUDE_API_KEY empty
#    - Install Ollama locally (free)
#    - Set VITE_OLLAMA_BASE_URL to localhost:11434

# 4. Never commit .env with real keys!
#    Add to .gitignore: .env, .env.local

# 5. For production:
#    - Set VITE_ENV=production
#    - Enable error tracking (Sentry)
#    - Disable debug mode

# 6. Test with:
#    npm run dev

# 7. Deploy with:
#    npm run build
#    npm run deploy
