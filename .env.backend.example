# KrishiVerse Backend - Environment Variables
# Copy this to .env and fill in actual values
# IMPORTANT: Never commit .env file with real secrets!

# ============================================
# APP CONFIGURATION
# ============================================

# Environment: development, staging, production
NODE_ENV=development

# Server port
PORT=3001

# API version
API_VERSION=v1

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Backend URL (for reference in emails, etc.)
BACKEND_URL=http://localhost:3001

# ============================================
# DATABASE (MongoDB)
# ============================================

# MongoDB Atlas connection string (free tier)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/krishiverse?retryWrites=true&w=majority

# Database name
DATABASE_NAME=krishiverse

# Enable MongoDB debug logging
MONGODB_DEBUG=true

# Connection pool size
MONGODB_POOL_SIZE=10

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Must be at least 32 characters
JWT_SECRET=your_super_secret_key_minimum_32_characters_long_generate_securely

# JWT Expiry (24 hours = 86400 seconds)
JWT_EXPIRY=86400

# Refresh Token Expiry (7 days = 604800 seconds)
REFRESH_TOKEN_EXPIRY=604800

# Password hash rounds (bcrypt)
BCRYPT_ROUNDS=10

# ============================================
# OTP & SMS (Twilio)
# ============================================

# Get from: https://www.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio phone number (must start with +)
TWILIO_PHONE_NUMBER=+12345678901

# OTP validity (600 seconds = 10 minutes)
OTP_EXPIRY=600

# OTP retry limit (attempts)
OTP_RETRY_LIMIT=3

# ============================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================

# SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Sender email
EMAIL_FROM=krishiverse@example.com
EMAIL_FROM_NAME=KrishiVerse

# ============================================
# CLOUDINARY (Image Storage)
# ============================================

# Get from: https://cloudinary.com
# Format: cloudinary://key:secret@cloud
CLOUDINARY_URL=cloudinary://key:secret@cloud_name

# Or set individually:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Image upload limits
MAX_IMAGE_SIZE=5242880 # 5 MB in bytes
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Upload folder prefix
CLOUDINARY_FOLDER=krishiverse

# ============================================
# REDIS (Caching - Optional)
# ============================================

# Redis URL (if using Redis Cloud: https://redis.com)
# Format: redis://user:password@host:port
REDIS_URL=redis://localhost:6379

# Redis password (if required)
REDIS_PASSWORD=

# Redis database (0-15)
REDIS_DB=0

# Cache TTL (in seconds)
CACHE_TTL=3600 # 1 hour

# Enable Redis caching
REDIS_ENABLED=false

# ============================================
# EXTERNAL APIs
# ============================================

# OpenWeatherMap API Key (from 1_PRD)
# Get from: https://openweathermap.org/api
OPENWEATHERMAP_KEY=your_openweather_api_key_here

# Google Places API Key (from 1_PRD)
# Get from: https://cloud.google.com/maps-platform
GOOGLE_PLACES_KEY=your_google_places_api_key_here

# Claude API Key (optional, for premium disease verification)
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=your_api_key

# ============================================
# ERROR TRACKING & MONITORING (Sentry)
# ============================================

# Sentry DSN (for error tracking)
# Get from: https://sentry.io
SENTRY_DSN=

# Enable Sentry
SENTRY_ENABLED=false

# Sentry sample rate (0.0 to 1.0)
SENTRY_TRACE_SAMPLE_RATE=0.1

# ============================================
# LOGGING
# ============================================

# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Log to file
LOG_FILE_ENABLED=false

# Log file location
LOG_FILE_PATH=./logs/app.log

# Max log file size (MB)
LOG_FILE_MAX_SIZE=10

# Max log files to keep
LOG_FILE_MAX_FILES=10

# ============================================
# RATE LIMITING
# ============================================

# Rate limit window (minutes)
RATE_LIMIT_WINDOW=15

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit for auth endpoints (stricter)
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ============================================
# ANALYTICS
# ============================================

# Enable analytics collection
ANALYTICS_ENABLED=true

# Retention period for analytics (days)
ANALYTICS_RETENTION_DAYS=90

# ============================================
# NOTIFICATIONS
# ============================================

# Enable push notifications
NOTIFICATIONS_ENABLED=false

# Notification service (fcm, apns, etc.)
NOTIFICATION_SERVICE=fcm

# Firebase Cloud Messaging (FCM) Key
FCM_SERVER_KEY=

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,https://codenest.github.io

# Allowed methods
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Allowed headers
CORS_HEADERS=Content-Type,Authorization,X-App-Version

# Credentials allowed
CORS_CREDENTIALS=true

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================

# Max upload size (bytes)
MAX_UPLOAD_SIZE=52428800 # 50 MB

# Temp upload directory
UPLOAD_TEMP_DIR=./temp/uploads

# Cleanup temp files (hours)
UPLOAD_CLEANUP_HOURS=24

# ============================================
# DATABASE BACKUP
# ============================================

# Enable automatic backups
BACKUP_ENABLED=false

# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup destination (S3, Google Drive, etc.)
BACKUP_DESTINATION=s3

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

# Seed database on startup (development only)
SEED_DATABASE=false

# Enable CORS for all origins (development only)
CORS_ALL=false

# Enable request logging
REQUEST_LOGGING=true

# Mock email sending (don't actually send)
MOCK_EMAIL=true

# Mock SMS sending (don't actually send)
MOCK_SMS=true

# ============================================
# FEATURE FLAGS
# ============================================

# Enable user registration
ENABLE_REGISTRATION=true

# Enable phone OTP login
ENABLE_OTP_LOGIN=true

# Enable email login (optional)
ENABLE_EMAIL_LOGIN=false

# Enable Claude API verification
ENABLE_CLAUDE_VERIFICATION=false

# Enable analytics tracking
ENABLE_ANALYTICS=true

# Enable admin dashboard
ENABLE_ADMIN_DASHBOARD=false

# ============================================
# API THROTTLING & QUOTAS
# ============================================

# API quota per user per day
API_QUOTA_PER_DAY=1000

# API quota per user per month
API_QUOTA_PER_MONTH=30000

# Claude API calls per user per day (if enabled)
CLAUDE_QUOTA_PER_DAY=10

# ============================================
# SECURITY HEADERS
# ============================================

# Enable security headers
SECURITY_HEADERS_ENABLED=true

# HSTS max age (seconds)
HSTS_MAX_AGE=31536000

# CSP policy
CSP_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'

# ============================================
# TIMEZONE
# ============================================

# Server timezone (use TZ database format)
TZ=Asia/Kolkata

# Date format for logs
DATE_FORMAT=YYYY-MM-DD HH:mm:ss

# ============================================
# NOTES
# ============================================

# 1. NEVER commit this file with real secrets!
#    Add to .gitignore: .env, .env.*.local
#
# 2. Generate secure secrets:
#    - JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 3. Get API keys from:
#    - MongoDB Atlas: https://www.mongodb.com/cloud/atlas
#    - Twilio: https://www.twilio.com (for OTP)
#    - Cloudinary: https://cloudinary.com (for image storage)
#    - OpenWeatherMap: https://openweathermap.org/api
#    - Google Places: https://cloud.google.com/maps-platform
#    - Sentry: https://sentry.io (optional, for error tracking)
#
# 4. For production:
#    - Set NODE_ENV=production
#    - Use strong, unique secrets
#    - Enable Sentry
#    - Enable HTTPS only
#    - Use environment variables from hosting provider
#
# 5. Testing with this file:
#    cp .env.backend.example .env
#    npm run dev
#
# 6. Deploy:
#    - Heroku: heroku config:set KEY=value
#    - AWS: Add to Elastic Beanstalk configuration
#    - Docker: Use --env-file .env
#    - Vercel: Add to project settings

# ============================================
# QUICK START
# ============================================

# For local development:
# 1. Copy this file: cp .env.backend.example .env
# 2. Get MongoDB connection string from Atlas
# 3. Fill in MONGODB_URI
# 4. Run: npm install && npm run dev
# 5. Server starts at http://localhost:3001

# For production on Heroku:
# 1. heroku create krishiverse-api
# 2. heroku config:set MONGODB_URI=... JWT_SECRET=...
# 3. git push heroku main
# 4. heroku open

# Health check:
# curl http://localhost:3001/api/v1/health
