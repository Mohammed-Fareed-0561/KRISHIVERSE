# Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Database (if applicable)
# MONGODB_URI=mongodb://localhost:27017/krishiverse

# API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Service
RAG_SERVICE_URL=http://localhost:8000

# Weather API
OPENWEATHER_API_KEY=your_openweather_api_key

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (if using authentication)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Farmer authentication hardening (all optional — defaults shown).
# Per-IP/per-email credential attempt budget, read on every request:
# AUTH_FAIL_MAX=5
# AUTH_FAIL_WINDOW_MS=900000
# Verification code / reset token lifetimes and resend cooldowns:
# AUTH_VERIFICATION_TTL_MS=900000
# AUTH_VERIFICATION_MAX_ATTEMPTS=5
# AUTH_VERIFICATION_COOLDOWN_MS=60000
# AUTH_RESET_TTL_MS=3600000
# AUTH_RESET_COOLDOWN_MS=60000
# Delivery: there is no SMTP/SMS provider yet. In non-production the API
# returns the code/token in the response (devCode/devToken) so QA can finish
# a flow; in production it NEVER returns or logs the secret and logs
# "auth delivery unconfigured" instead. Wire a provider in
# src/services/delivery.js when one is available.

# Laya decision service (backend-only, optional).
# LAYA_ENABLED=false disables POST /decision/laya with 503.
# LAYA_MODEL_URL points at a VERIFIED real Laya sidecar: `laya-serve`
# (convaiinnovations/laya, Apache-2.0) exposing POST {LAYA_MODEL_URL}/v1/systemone.
# Verified 2026-09-30 with laya 0.3.22 + convaiinnovations/laya-multilingual.
# When empty, the deterministic `laya-builtin-decider` is used (offline-safe).
# See docs/laya-integration.md §4 for sidecar setup. Flag stays OFF by default.
LAYA_ENABLED=true
LAYA_MODEL_URL=
LAYA_MODEL=multilingual
LAYA_TIMEOUT_MS=8000


# Admin observability dashboard (/api/admin — never used by farmer routes)
# Provision the first admin account at startup (secrets are never logged):
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-very-long
# ADMIN_ROLE=superadmin
# Allow restore drill to write outside backend/backups (default: false, drill only):
# ADMIN_ALLOW_RESTORE=false
# Readiness scorecard targets (hours):
# ADMIN_RTO_HOURS=4
# ADMIN_RPO_HOURS=24
# Backup output directory (default: backend/backups, git-ignored):
# ADMIN_BACKUP_DIR=backups
# Passive request telemetry sampling 0..1 (failures are always kept; test env skips):
# TELEMETRY_SAMPLE_RATE=0.25
